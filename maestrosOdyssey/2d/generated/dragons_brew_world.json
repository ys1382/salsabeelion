  "npcs": [
    {
      "id": "elder",
      "x": 9,
      "y": 18,
      "name": "Elder",
      "role": "block elder",
      "persona": "Warm, practical, looks after the block without making a fuss.",
      "secret": "Glad the neighborhood still looks after people who want to learn it properly.",
      "could_know": "Lives on this street and keeps the learning cards; sends newcomers to Dragon's Brew first",
      "opener": "Good morning, dear. I'm one of the elders who helps look after this block. You've been part of the neighborhood for a while now.",
      "movement": "idle",
      "tint": "#d4af6a",
      "takes": ["gooseberries"],
      "wants_item": "",
      "gives_item": "",
      "reveal_beat": "",
      "scripted_lines": [
        "Good morning, dear. I'm one of the elders who helps look after this block. You've been part of the neighborhood for a while now.",
        "When someone wants to learn the block properly \u2014 not just pass through like a tourist \u2014 the community keeps a learning card for them. I'd like you to have one.",
        "I'm loading yours with about a week's worth of meals at the counter \u2014 400 pesos. Use it when you order. When the balance reads zero, that's the end of it. We don't borrow past zero, so you never owe more than what's on the card.",
        "Dragon's Brew down the path is the kindest place to start. It's a warm room with a good counter, and every species is welcome there. Take your mornings there when you're ready.",
        "While you're there, notice the menu, the house rules on the wall, and the people who share the room \u2014 not gossip, nothing like that. Just what a good neighbor would notice, with kind eyes.",
        "On the same weekday next week, I'll check in with you. Tell me your favorite drink and your favorite food \u2014 the way they say it there, with something extra like con leche.",
        "The card is in the basket by my door \u2014 take it when you're ready. The street is waiting."
      ]
    },
    {
      "id": "mara",
      "x": 19,
      "y": 13,
      "inside": "dragons_brew",
      "inside_x": 7,
      "inside_y": 4,
      "name": "Mara",
      "role": "barista",
      "persona": "Smart, gentle, keeps her mouth shut when she wants. Makes the room feel safe.",
      "secret": "Notices more than she says, and will not pass table talk.",
      "could_know": "Works the counter at Dragon's Brew every morning and sees who comes through the door",
      "opener": "You're fine \u2014 take your time. The board is there when you're ready.",
      "movement": "idle",
      "tint": "#241c1e",
      "look": "campire",
      "wants_item": "",
      "reveal_beat": "mara_campire",
      "scripted_lines": [
        "Laughs gently, and waves a hand as if waving away your nervousness. \"You're fine, there's not a lot of my kind in this area. I'm a \u00c7ampire\u2014vampire and werecat somewhere down the line. The wings plus the tail are a fun conversation starter.\"",
        "When you're ready, the drink menu is on the wall. Have a look \u2014 then I can take your order.",
        "What's your order?"
      ]
    },
    {
      "id": "iguana_neighbor",
      "x": 24,
